{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@dietrichgebert/ponytail",
    "./.opencode/plugins/antislop-guard.ts"
  ],
  "skills": {
    "paths": [".opencode/skills", ".agents/skills"]
  },
  "instructions": [
    "AGENTS.md",
    ".opencode/rules/anti-slop-rules.md"
  ],
  "permission": {
    "bash": {
      "git push *": "ask",
      "git reset --hard *": "deny",
      "git clean *": "deny"
    }
  }
}
